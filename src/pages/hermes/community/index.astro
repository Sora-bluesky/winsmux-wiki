    border: 1px solid #bfdbfe;
    background: var(--color-accent-soft);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
  }
  .cm-weeks { display: flex; flex-direction: column; gap: 2.2rem; margin-top: 1.75rem; }
  .cm-week-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
    border-bottom: 1px solid var(--color-border-strong); padding-bottom: 0.5rem; margin-bottom: 0.9rem;
  }
  .cm-title { font-size: 1.05rem; font-weight: 650; margin: 0; }
  .cm-weekno { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-fg-muted); }
  .cm-cards { display: flex; flex-direction: column; gap: 0.9rem; }
  .cm-card {
    border: 1px solid var(--color-border); border-radius: 12px; padding: 0.9rem 1.1rem 1rem;
    background: var(--color-bg); display: flex; flex-direction: column; gap: 0.55rem;
  }
  .cm-channel {
    align-self: flex-start; font-family: var(--font-mono); font-size: 0.74rem; font-weight: 500;
    color: var(--color-accent); background: var(--color-accent-soft); border-radius: 999px; padding: 0.15rem 0.7rem;
  }
  .cm-list { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .cm-list li { font-size: 0.88rem; line-height: 1.7; color: var(--color-fg-secondary); }
  .cm-list li::marker { color: var(--color-border-strong); }
</style>
