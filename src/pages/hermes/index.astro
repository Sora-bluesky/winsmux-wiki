---
// トップ（案A ポータル型・2026-08-27 sora 選定。design/canvas/Main.dc.html が設計正本）。
// 「今週の更新」は data/wiki-updates.json の実データ最新3件。
import BaseLayout from '../../layouts/BaseLayout.astro';
import updates from '../../../data/wiki-updates.json';
import howto from '../../../data/wiki/howto.json';
import trouble from '../../../data/wiki/trouble.json';
import catalog from '../../../data/portal-models.json';

type Entry = { date: string; pages: { id: string; title: string; url: string }[] };
const recent = (updates.entries as Entry[]).slice(0, 3);
const latest = recent[0];
const line = (e: Entry) =>
  e.pages.length === 1 ? `「${e.pages[0].title}」を訳し直しました` : `${e.pages.length}ページを訳し直しました（${e.pages[0].title} など）`;

const tiles = [
  {
    href: '/hermes/howto/',
    title: '逆引き',
    body: `「〜したい」から最短の手順ページへ。全${howto.items.length}項目・${howto.categories.length}分類。カタカナ・全角でも検索が当たります。`,
  },
  {
    href: '/hermes/trouble/',
    title: 'トラブル',
    body: `症状から原因と対処を引く表。全${trouble.items.length}項目。つながらない・鍵が通らない・ジョブが動かない。`,
  },
  {
    href: '/hermes/models/',
    title: 'モデルと料金',
    body: `Portal 掲載の全${catalog.count}モデルの価格・割引・無料枠の一覧。毎日自動更新。`,
  },
  {
    href: '/hermes/guide/all/',
    title: 'ドキュメント',
    body: '公式 docs 全ページの日本語版の索引。構成・コード・リンクは公式とバイト一致。',
  },
];


---

<BaseLayout
  title="Hermes Agent Wiki"
  description="Hermes Agent の日本語知識ベース。公式ドキュメント全ページの日本語版に、逆引き・トラブル対処・料金の早見をのせた非公式サイトです。"
  rawPath="/hermes/raw/index.md"
  sources={['https://hermes-agent.nousresearch.com/docs/']}
  hermesVersion="0.20.6"
  prevOverride={null}
  nextOverride={null}
>
  <section class="hero-grid">
    <div class="hero">
      <h1>Hermes Agent Wiki</h1>
      <p class="hero-catch">Hermes Agent の日本語ドキュメント。毎日更新、AI にも渡せる</p>
      <p class="hero-lead">
        公式ドキュメント全400ページ超の日本語版に、逆引き・トラブル対処・料金の早見をのせた<strong>非公式</strong>サイトです。正本は常に
        <a href="https://hermes-agent.nousresearch.com/docs/" target="_blank" rel="noopener">Hermes Agent Documentation</a> です。
      </p>
      <button type="button" class="hero-search js-search-open" aria-label="検索を開く（Ctrl+K）">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        やりたいこと・エラー文で検索（Ctrl+K）
      </button>
      <div class="hero-ai" data-hero-ai>
        <span class="hero-ai-label">このサイトを AI に渡して質問:</span>
        <button type="button" data-hero-ai-open="chatgpt">ChatGPT</button>
        <button type="button" data-hero-ai-open="claude">Claude</button>
        <button type="button" data-hero-ai-open="gemini">Gemini</button>
        <button type="button" data-hero-ai-open="grok">Grok</button>
      </div>
    </div>
    <aside class="ai-panel" aria-label="AI に渡す">
      <div class="ai-panel-head">
        <span class="ai-panel-title">AI に渡す</span>
        <span class="ai-panel-badge">ChatGPT・Claude の回答生成に参照されています</span>
      </div>
      <a href="/hermes/llms.txt" class="ai-panel-row">
        <span class="ai-row-title">llms.txt（サイト全体の索引）</span>
        <code>/hermes/llms.txt</code>
      </a>
      <a href="/hermes/raw/index.md" class="ai-panel-row">
        <span class="ai-row-title">全ページの Markdown 版</span>
        <code>/hermes/raw/…</code>
      </a>
      <a href="/hermes/raw/models.md" class="ai-panel-row">
        <span class="ai-row-title">モデル{catalog.count}件の料金データ（毎日更新）</span>
        <code>/hermes/raw/models.md</code>
      </a>
    </aside>
  </section>

  <div class="trust-strip">
    <span class="trust-live"><span class="dot"></span>公式に毎日追随{latest ? `・最新 ${latest.date}・${latest.pages.length}ページを更新` : ''}</span>
    <span class="trust-owner">運営: そら（<a href="https://x.com/sora_biz" target="_blank" rel="noopener">@sora_biz</a>）</span>
  </div>

  <div class="tiles">
    {
      tiles.map((t) => (
        <a href={t.href} class="tile">
          <span class="tile-title">{t.title}</span>
          <span class="tile-body">{t.body}</span>
        </a>
      ))
    }
  </div>

  <nav class="more-links" aria-label="そのほかのページ">
    <a href="/hermes/first/">初めての方へ</a>
    <a href="/hermes/guide/">使いかた</a>
    <a href="/hermes/trust/">任せかたと運用</a>
    <a href="/hermes/from-claude-code/">乗り換え</a>
    <a href="/hermes/japanese/">日本語入力</a>
    <a href="/hermes/community/">コミュニティ</a>
    <a href="/hermes/updates/">今週の更新</a>
    <a href="https://www.youtube.com/watch?v=BeWUUclCin0&list=PLmpUb_PWAkDx-VWjh00tVCji794xAa_IX" target="_blank" rel="noopener">動画で学ぶ↗</a>
    <a href="/hermes/about/">このサイトについて</a>
  </nav>
</BaseLayout>

<style>
  :global(main) { padding-top: 0.9rem !important; padding-bottom: 0.6rem !important; }
  :global([data-copy-page]) { display: none; }
  :global(main aside) { display: none; }
  :global(footer) { padding: 0 !important; margin-top: 0 !important; }
  :global(footer > div) { padding-top: 0.7rem !important; padding-bottom: 0.7rem !important; gap: 0.4rem !important; }
  .hero-grid { display: grid; gap: 1.6rem; padding: 0.6rem 0 1rem; align-items: start; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.25fr 1fr; gap: 3rem; } }
  .hero { display: flex; flex-direction: column; align-items: center; gap: 0.85rem; text-align: center; }
  @media (min-width: 1024px) { .hero { align-items: flex-start; text-align: left; } }
  .hero h1 { font-size: clamp(1.7rem, 3.8vw, 2.4rem); line-height: 1.2; margin: 0; letter-spacing: -0.02em; }
  .hero-catch { margin: -0.25rem 0 0; font-size: clamp(0.9rem, 1.6vw, 1.02rem); font-weight: 600; color: var(--color-accent); }
  .hero-lead { margin: 0; max-width: 40rem; font-size: 0.9rem; line-height: 1.8; color: var(--color-fg-secondary); }
  .hero-search {
    display: flex; align-items: center; gap: 0.75rem; width: 100%; max-width: 40rem;
    border: 1px solid var(--color-border-strong); border-radius: 12px; background: var(--color-bg);
    padding: 0.75rem 1.05rem; font-size: 0.92rem; color: var(--color-fg-muted); cursor: pointer;
    box-shadow: 0 1px 2px rgb(27 27 27 / 0.04);
  }
  .hero-search:hover { border-color: var(--color-accent); color: var(--color-fg-secondary); }
  .hero-ai { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; }
  @media (min-width: 1024px) { .hero-ai { justify-content: flex-start; } }
  .hero-ai-label { font-size: 0.78rem; color: var(--color-fg-muted); }
  .hero-ai button {
    border: 1px solid var(--color-border); background: var(--color-bg); border-radius: 999px;
    padding: 0.42rem 1rem; font-size: 0.82rem; font-weight: 500; color: var(--color-fg); cursor: pointer;
  }
  .hero-ai button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .hero-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; max-width: 44rem; }
  @media (min-width: 1024px) { .hero-chips { justify-content: flex-start; } }
  .hero-chips a {
    font-size: 0.8rem; color: var(--color-accent); background: var(--color-accent-soft);
    border-radius: 999px; padding: 0.4rem 0.85rem; text-decoration: none;
  }
  .hero-chips a:hover { background: #dbeafe; }
  .ai-panel {
    display: flex; flex-direction: column; gap: 0.55rem; background: var(--color-bg-subtle);
    border: 1px solid var(--color-border); border-radius: 16px; padding: 1.05rem 1.2rem;
  }
  .ai-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .ai-panel-title { font-size: 0.95rem; font-weight: 700; color: var(--color-fg); }
  .ai-panel-badge { font-size: 0.7rem; color: #16a34a; font-weight: 600; }
  .ai-panel-row {
    display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
    background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 12px;
    padding: 0.6rem 0.9rem; text-decoration: none;
  }
  .ai-panel-row:hover { border-color: var(--color-border-strong); }
  .ai-row-title { display: block; font-size: 0.84rem; font-weight: 600; color: var(--color-fg); }
  .ai-row-note { display: block; font-size: 0.72rem; color: var(--color-fg-muted); margin-top: 0.1rem; }
  .ai-panel-row code { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-accent); white-space: nowrap; }
  .trust-strip {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
    background: var(--color-accent-soft); border-radius: 14px; padding: 0.7rem 1.2rem; margin-bottom: 1.1rem;
  }
  .trust-live { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; font-weight: 600; color: #166534; }
  .dot { width: 6px; height: 6px; border-radius: 99px; background: #16a34a; }
  .trust-owner { font-size: 0.78rem; color: var(--color-fg-muted); }
  .tiles { display: grid; gap: 0.85rem; }
  @media (min-width: 640px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tile {
    display: flex; flex-direction: column; gap: 0.35rem; border: 1px solid var(--color-border);
    border-radius: 12px; padding: 1rem 1.1rem; background: var(--color-bg); text-decoration: none; transition: 0.15s;
  }
  .tile:hover { border-color: var(--color-border-strong); background: var(--color-bg-subtle); }
  .tile-title { font-weight: 600; color: var(--color-fg); font-size: 0.98rem; }
  .tile-body { font-size: 0.8rem; line-height: 1.6; color: var(--color-fg-secondary); }
  .more-links { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; padding-bottom: 0; }
  .more-links a {
    font-size: 0.78rem; color: var(--color-fg-secondary); border: 1px solid var(--color-border);
    border-radius: 8px; padding: 0.4rem 0.7rem; text-decoration: none; background: var(--color-bg);
  }
  .more-links a:hover { background: var(--color-bg-subtle); color: var(--color-fg); }
</style>

<script is:inline>
  // ヒーローの AI ボタン: 公式 docs と同型（プロンプト入り URL。Gemini はコピーしてから開く）
  (function () {
    var wrap = document.querySelector('[data-hero-ai]');
    if (!wrap) return;
    var text = 'このサイトの索引 https://wiki.winsmux.dev/hermes/llms.txt を読んで、Hermes Agent について質問に答えて';
    var urls = { chatgpt: 'https://chatgpt.com/?q=', claude: 'https://claude.ai/new?q=', grok: 'https://grok.com/?q=' };
    wrap.querySelectorAll('[data-hero-ai-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var ai = btn.getAttribute('data-hero-ai-open');
        if (ai === 'gemini') {
          navigator.clipboard.writeText(text).then(
            function () { btn.textContent = 'コピーしました'; },
            function () {},
          ).then(function () {
            window.open('https://gemini.google.com/app', '_blank', 'noopener');
            setTimeout(function () { btn.textContent = 'Gemini'; }, 3000);
          });
        } else {
          window.open(urls[ai] + encodeURIComponent(text), '_blank', 'noopener');
        }
      });
    });
  })();
</script>
