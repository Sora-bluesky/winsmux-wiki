---
// トップ（sora 提供モック hermes-wiki-top-redesign.html 準拠・2026-08-30 採用）。
// H1「Hermes Agent Wiki」とキャッチは現行のまま（sora 指示）。トップでは左右サイドバーを出さない。
// 数値（項目数・モデル数・更新日）は JSON から動的に描画する。
import BaseLayout from '../../layouts/BaseLayout.astro';
import updates from '../../../data/wiki-updates.json';
import howto from '../../../data/wiki/howto.json';
import trouble from '../../../data/wiki/trouble.json';
import catalog from '../../../data/portal-models.json';

type Entry = { date: string; pages: { id: string; title: string; url: string }[] };
const latest = (updates.entries as Entry[])[0];
---

<BaseLayout
  title="Hermes Agent Wiki"
  description="Hermes Agent の日本語知識ベース。公式ドキュメント全ページの日本語版に、逆引き・トラブル対処・料金の早見をのせた非公式サイトです。"
  rawPath="/hermes/raw/index.md"
  sources={['https://hermes-agent.nousresearch.com/docs/']}
  hermesVersion="0.21.0"
  prevOverride={null}
  nextOverride={null}
>
  <section class="hero">
    <div class="kicker">非公式の日本語wiki · 毎日更新{updates.generatedAt ? `（最終同期 ${updates.generatedAt}）` : ''}</div>
    <h1>Hermes Agent Wiki</h1>
    <p class="catch">Hermes Agent の日本語ドキュメント。毎日更新、AI にも渡せる</p>
    <p class="lead">
      公式ドキュメントの日本語版です。逆引きとトラブル対処のページも用意しています。<br />正本は
      <a href="https://hermes-agent.nousresearch.com/docs/" target="_blank" rel="noopener">公式ドキュメント</a>です。
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/hermes/first/">初めての方へ</a>
      <a class="btn btn-secondary" href="/hermes/docs/getting-started/quickstart/">インストールする</a>
      <a class="btn btn-secondary" href="/hermes/trouble/">症状から探す</a>
    </div>
    <button type="button" class="search js-search-open" aria-label="検索を開く（Ctrl+K）">
      🔍 やりたいこと・エラー文で検索
    </button>
    <p class="note">例: Telegram がつながらない / cron を仕込みたい / Windows に入れたい</p>
  </section>

  <section class="grid">
    <a class="card start" href="/hermes/first/">
      <b>初めて使う</b>
      <p>入れる → 話す → スマホから。次の一歩だけ示す入口です。</p>
      <span class="go">初めての方へ →</span>
    </a>
    <a class="card" href="/hermes/trouble/">
      <b>動かない・繋がらない</b>
      <p>つながらない、鍵が通らない、ジョブが動かない。症状から{trouble.items.length}項目。</p>
      <span class="go">トラブル →</span>
    </a>
    <a class="card" href="/hermes/howto/">
      <b>やりたいことから探す</b>
      <p>最短手順への逆引き。導入・つなぐ・自動化など{howto.items.length}項目。</p>
      <span class="go">逆引き →</span>
    </a>
    <a class="card" href="/hermes/models/">
      <b>モデルと料金</b>
      <p>Portal掲載の価格・割引・無料枠。{catalog.count}件を毎日更新。</p>
      <span class="go">料金表 →</span>
    </a>
  </section>

  <section class="section">
    <h2>よく使うページ</h2>
    <div class="used">
      <a class="chip" href="/hermes/docs/getting-started/quickstart/">インストールする</a>
      <a class="chip" href="/hermes/docs/user-guide/messaging/telegram/">Telegram でつなぐ</a>
      <a class="chip" href="/hermes/docs/user-guide/features/cron/">定時実行（Cron）</a>
      <a class="chip" href="/hermes/japanese/">日本語入力</a>
      <a class="chip" href="/hermes/from-claude-code/">Claude Code から乗り換え</a>
    </div>
  </section>

  <section class="section" data-hero-ai>
    <details class="ai">
      <summary>このサイトを AI に渡して質問する</summary>
      <div class="ai-body">
        ChatGPT / Claude の回答生成に、このwikiの索引が参照されています。
        <div class="ai-row">
          <button type="button" class="chip" data-hero-ai-open="chatgpt">ChatGPT で開く</button>
          <button type="button" class="chip" data-hero-ai-open="claude">Claude で開く</button>
          <button type="button" class="chip" data-hero-ai-open="gemini">Gemini で開く</button>
          <button type="button" class="chip" data-hero-ai-open="grok">Grok で開く</button>
        </div>
        <button type="button" class="copy" data-ai-copy="/hermes/llms.txt"><span>llms.txt（サイト全体の索引）</span><code>コピー</code></button>
        <button type="button" class="copy" data-ai-copy="/hermes/raw/index.md"><span>全ページの Markdown 版</span><code>コピー</code></button>
        <button type="button" class="copy" data-ai-copy="/hermes/raw/models.md"><span>モデル{catalog.count}件の料金データ</span><code>コピー</code></button>
      </div>
    </details>
  </section>
</BaseLayout>

<style>
  /* トップ限定: ページをコピー行・右の目次だけ出さない（左サイドバーは表示する） */
  :global([data-copy-page]) { display: none; }
  :global([data-rail-popular]) { display: none; }
  :global(main aside) { display: none; }
  :global(main) { padding-top: 0 !important; }

  .hero { padding: 1.4rem 0 0.4rem; }
  .kicker { font-size: 0.82rem; color: var(--color-fg-muted); margin-bottom: 0.5rem; }
  h1 { font-size: 2.1rem; letter-spacing: -0.03em; margin: 0 0 0.5rem; line-height: 1.2; }
  .catch { margin: 0 0 0.6rem; font-size: 1.02rem; font-weight: 600; color: var(--color-accent); }
  .lead { color: var(--color-fg-secondary); margin: 0 0 1.1rem; max-width: 36em; font-size: 0.95rem; line-height: 1.8; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1rem; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 10px; padding: 0.62rem 1rem; font-weight: 700; font-size: 0.88rem; text-decoration: none;
  }
  .btn-primary { background: var(--color-accent); color: #fff; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-secondary { background: var(--color-bg); color: var(--color-fg); border: 1px solid var(--color-border-strong); }
  .btn-secondary:hover { background: var(--color-bg-subtle); }
  .search {
    display: flex; align-items: center; gap: 0.5rem; width: 100%;
    border: 1px solid var(--color-border-strong); border-radius: 12px; padding: 0.75rem 0.9rem;
    color: var(--color-fg-muted); margin-bottom: 0.6rem; background: var(--color-bg);
    font-size: 0.92rem; cursor: pointer; text-align: left; font-family: inherit;
  }
  .search:hover { border-color: var(--color-accent); }
  .note { font-size: 0.82rem; color: var(--color-fg-muted); margin: 0 0 1.2rem; }

  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1.1rem; }
  .card {
    border: 1px solid var(--color-border); border-radius: 12px;
    padding: 1rem; background: var(--color-bg); min-height: 128px; text-decoration: none;
    display: flex; flex-direction: column;
  }
  .card:hover { border-color: #b9c4f5; background: #fafbff; }
  .card b { display: block; font-size: 1rem; margin-bottom: 0.4rem; color: var(--color-fg); }
  .card p { margin: 0; font-size: 0.82rem; color: var(--color-fg-secondary); line-height: 1.65; }
  .card .go { display: inline-block; margin-top: auto; padding-top: 0.6rem; font-size: 0.82rem; font-weight: 700; color: var(--color-accent); }
  .card.start { border-color: #c9d3ff; background: var(--color-accent-soft); }

  .section { padding: 0.5rem 0 1rem; }
  .section h2 { font-size: 1rem; margin: 0 0 0.6rem; }
  .used { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    border: 1px solid var(--color-border); border-radius: 999px; padding: 0.45rem 0.75rem;
    font-size: 0.82rem; color: var(--color-fg); background: var(--color-bg); text-decoration: none;
    font-family: inherit; cursor: pointer;
  }
  .chip:hover { background: var(--color-bg-subtle); }

  details.ai {
    border: 1px solid var(--color-border); border-radius: 12px;
    padding: 0.75rem 0.9rem; background: var(--color-bg-subtle); margin-top: 0.5rem;
  }
  details.ai summary { cursor: pointer; font-weight: 700; font-size: 0.9rem; }
  .ai-body { margin-top: 0.6rem; font-size: 0.82rem; color: var(--color-fg-secondary); }
  .ai-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .copy {
    display: flex; justify-content: space-between; gap: 0.5rem; align-items: center; width: 100%;
    background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 8px;
    padding: 0.5rem 0.65rem; margin-top: 0.4rem; font-family: inherit; font-size: 0.82rem;
    color: var(--color-fg); cursor: pointer; text-align: left;
  }
  .copy:hover { border-color: var(--color-border-strong); }
  .copy code { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-accent); }

  @media (max-width: 860px) {
    h1 { font-size: 1.75rem; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // AI ボタン: 公式 docs と同型（プロンプト入り URL。Gemini はコピーしてから開く）
  (function () {
    var wrap = document.querySelector('[data-hero-ai]');
    if (!wrap) return;
    var text = 'このサイトの索引 https://wiki.winsmux.dev/hermes/llms.txt を読んで、Hermes Agent について質問に答えて';
    var urls = { chatgpt: 'https://chatgpt.com/?q=', claude: 'https://claude.ai/new?q=', grok: 'https://grok.com/?q=' };
    document.querySelectorAll('[data-ai-copy]').forEach(function (row) {
      row.addEventListener('click', function () {
        var code = row.querySelector('code');
        fetch(row.getAttribute('data-ai-copy'))
          .then(function (r) { return r.text(); })
          .then(function (t) { return navigator.clipboard.writeText(t); })
          .then(function () { code.textContent = 'コピーしました'; })
          .catch(function () { code.textContent = 'コピーできませんでした'; })
          .then(function () { setTimeout(function () { code.textContent = 'コピー'; }, 2500); });
      });
    });
    wrap.querySelectorAll('[data-hero-ai-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var ai = btn.getAttribute('data-hero-ai-open');
        if (ai === 'gemini') {
          navigator.clipboard.writeText(text).then(
            function () { btn.textContent = 'コピーしました。貼り付けてください'; },
            function () {},
          ).then(function () {
            window.open('https://gemini.google.com/app', '_blank', 'noopener');
            setTimeout(function () { btn.textContent = 'Gemini で開く'; }, 3000);
          });
        } else {
          window.open(urls[ai] + encodeURIComponent(text), '_blank', 'noopener');
        }
      });
    });
  })();
</script>
