---
import indexSrc from '../../raw/index.md?raw';
import { buildDoc } from '../../lib/doc';
import Card from '../../components/Card.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const doc = buildDoc('index', indexSrc);
// 見出しより上のカード2枚が入口。本文(markdown)がガイドの本体。
const [rawIntro, ...rest] = doc.html.split('<h2');
// 入口では折りたたみ目次・右レールを出さない(カードとガイド本文が主役)
const intro = rawIntro
  .replace(/<details class="toc[\s\S]*?<\/details>/, '')
  .replace(/<nav class="toc-rail[\s\S]*?<\/nav>/, '');
const body = rest.length ? '<h2' + rest.join('<h2') : '';
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  rawPath={doc.rawPath}
  sources={doc.sources}
  hermesVersion={doc.hermesVersion}
  confidence={doc.confidence}
>
  <article class="prose" set:html={intro} />
  <div class="mt-8 grid gap-4">
    <Card
      href="/hermes/docs/getting-started/quickstart/"
      title="Hermes Agentをインストールする"
      body="公式クイックスタートの日本語版です。入れて、モデルを選び、最初の会話まで。"
    />
    <Card
      href="/hermes/docs/getting-started/learning-path/"
      title="レベルごとの読みかた"
      body="初級・中級・上級それぞれの、読む順番と所要時間の目安です。公式の学習パスの日本語版。"
    />
  </div>
  <article class="prose mt-10" set:html={body} />
</BaseLayout>
