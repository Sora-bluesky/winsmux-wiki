---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import tips from '../../../../data/wiki/tips.json';

type Tip = {
  n: number;
  date: string;
  url: string;
  feature: string;
  title_ja: string;
  summary_ja: string;
  category: string;
  links: { title: string; url: string }[];
  tags: string[];
};

const categories = tips.categories as string[];
const items = tips.items as Tip[];
const byCat = categories.map((c) => ({
  name: c,
  items: items.filter((i) => i.category === c).sort((a, b) => b.n - a.n),
}));

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const summaryHtml = (summary: string) =>
  escapeHtml(summary).replace(/`([^`]+)`/g, '<code>$1</code>');
---

<BaseLayout
  rawPath="/hermes/raw/tips.md"
  title="小ワザ集"
  description={`Nous Research の @witcheer が X で連載している Hermes Wingtips（全 ${items.length} 回）を日本語で紹介する索引。各回に元のポストと公式ドキュメント日本語版へのリンク。`}
  sources={['https://hermes-agent.nousresearch.com/docs/', 'https://x.com/witcheer']}
  prevOverride={null}
  nextOverride={null}
>
  <article class="prose">
    <h1>小ワザ集</h1>
    <p>
      Nous Research のコミュニティ担当
      <a href={tips.authorUrl} target="_blank" rel="noopener">@{tips.author}</a>
      が X で連載している Hermes Wingtips を、日本語で探せるようにまとめました。
    </p>
    <p class="wiki-note">このページはこのサイト独自の索引です。正本は各リンク先の公式ページと元のポストです。</p>
  </article>

  <div class="hw-controls">
    <input id="hw-search" type="search" placeholder="小ワザを検索" aria-label="小ワザを検索" />
    <div class="hw-chips" role="group" aria-label="カテゴリで絞り込み">
      <button type="button" class="hw-chip active" data-cat="all">すべて（{items.length}）</button>
      {byCat.map((c) => (
        <button type="button" class="hw-chip" data-cat={c.name}>{c.name}（{c.items.length}）</button>
      ))}
    </div>
  </div>

  <div class="hw-groups">
    {
      byCat.map((c) => (
        <section class="hw-group" data-cat={c.name}>
          <h2 class="hw-cat">{c.name}</h2>
          <div class="hw-list">
            {c.items.map((i) => (
              <div
                class:list={['hw-row', i.links.length > 0 && 'hw-clickable']}
                data-want={`${i.title_ja} ${i.summary_ja} ${i.feature} ${i.tags.join(' ')} ${i.links.map((l) => l.title).join(' ')}`.toLowerCase()}
              >
                <div class="hw-main">
                  <span class="hw-want"><span class="hw-number">#{i.n}</span> <Fragment set:html={summaryHtml(i.title_ja)} /></span>
                  <span class="hw-note" set:html={summaryHtml(i.summary_ja)} />
                </div>
                <div class="hw-links">
                  {i.links.map((l, li) => (
                    <a href={l.url} class:list={[li === 0 ? 'hw-primary' : '']}>{l.title} →</a>
                  ))}
                  <a href={i.url} target="_blank" rel="noopener">元のポスト（X）→</a>
                  <time class="hw-date" datetime={i.date}>{i.date}</time>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
    <p id="hw-empty" class="hw-empty" hidden>該当する項目がありません。<a href="/hermes/search/">全文検索</a> を試してください。</p>
  </div>
</BaseLayout>

<style>
  .wiki-note {
    border: 1px solid #bfdbfe;
    background: var(--color-accent-soft);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
  }
  .hw-controls { display: flex; flex-direction: column; gap: 0.75rem; margin: 1.25rem 0 1.25rem; }
  #hw-search {
    width: 100%; max-width: 420px; border: 1px solid var(--color-border-strong); border-radius: 8px;
    padding: 0.6rem 0.9rem; font-size: 0.9rem; background: var(--color-bg); color: var(--color-fg);
  }
  .hw-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .hw-chip {
    border: 1px solid var(--color-border); background: transparent; color: var(--color-fg-secondary);
    border-radius: 999px; padding: 0.35rem 0.85rem; font-size: 0.8rem; cursor: pointer;
  }
  .hw-chip:hover { background: var(--color-bg-subtle); }
  .hw-chip.active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; font-weight: 600; }
  .hw-groups { display: flex; flex-direction: column; gap: 1.5rem; }
  .hw-cat { font-size: 0.9rem; font-weight: 600; color: var(--color-fg-muted); margin: 0 0 0.5rem; }
  .hw-list { display: flex; flex-direction: column; border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; }
  .hw-row {
    position: relative;
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding: 0.75rem 1.1rem; border-bottom: 1px solid var(--color-border); background: var(--color-bg);
  }
  .hw-row:last-of-type { border-bottom: 0; }
  .hw-row.hw-clickable { cursor: pointer; }
  .hw-row:hover { background: var(--color-bg-subtle); }
  .hw-links a { position: relative; z-index: 1; }
  .hw-links a.hw-primary { position: static; }
  .hw-links a.hw-primary::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .hw-main { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; flex: 1 1 auto; }
  .hw-want { font-weight: 600; color: var(--color-fg); font-size: 0.92rem; }
  .hw-number { color: var(--color-fg-muted); }
  .hw-note { font-size: 0.8rem; color: var(--color-fg-muted); line-height: 1.55; }
  .hw-links { display: flex; flex-direction: column; gap: 0.2rem; text-align: right; flex: 0 1 16rem; min-width: 0; }
  .hw-links a { font-size: 0.8rem; text-decoration: none; }
  @media (max-width: 640px) {
    .hw-row { flex-direction: column; align-items: stretch; gap: 0.4rem; }
    .hw-links { text-align: left; flex-basis: auto; }
  }
  .hw-links a:hover { text-decoration: underline; }
  .hw-date { font-size: 0.75rem; color: var(--color-fg-muted); }
  .hw-empty { color: var(--color-fg-muted); font-size: 0.9rem; margin: 0; }
</style>

<script>
  import { filterByQuery, normalizeText } from '../../../lib/search-aliases';
  const search = document.getElementById('hw-search') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.hw-chip')];
  const groups = [...document.querySelectorAll<HTMLElement>('.hw-group')];
  const empty = document.getElementById('hw-empty')!;
  let cat = 'all';

  const allRows = groups.flatMap((g) => [...g.querySelectorAll<HTMLElement>('.hw-row')].map((r) => ({ g, r })));

  function apply() {
    const hit = filterByQuery(allRows.map(({ r }) => normalizeText(r.dataset.want ?? '')), search.value);
    let shown = 0;
    const perGroup = new Map<HTMLElement, number>();
    allRows.forEach(({ g, r }, i) => {
      const okC = cat === 'all' || g.dataset.cat === cat;
      const on = okC && hit[i];
      r.hidden = !on;
      if (on) {
        shown++;
        perGroup.set(g, (perGroup.get(g) ?? 0) + 1);
      }
    });
    for (const g of groups) g.hidden = (perGroup.get(g) ?? 0) === 0;
    empty.hidden = shown > 0;
  }
  search.addEventListener('input', apply);
  for (const c of chips) {
    c.addEventListener('click', () => {
      cat = c.dataset.cat ?? 'all';
      for (const x of chips) x.classList.toggle('active', x === c);
      apply();
    });
  }
  const params = new URLSearchParams(location.search);
  const pCat = params.get('cat');
  const pQ = params.get('q');
  if (pCat) {
    const chip = chips.find((c) => c.dataset.cat === pCat);
    if (chip) chip.click();
  }
  if (pQ) {
    search.value = pQ;
    apply();
  }
</script>
