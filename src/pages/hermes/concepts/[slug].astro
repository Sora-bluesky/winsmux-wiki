---
import { buildDoc } from '../../../lib/doc';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const files = import.meta.glob('../../../raw/concepts/*.md', {
    query: '?raw',
    import: 'default',
    eager: true,
  }) as Record<string, string>;
  return Object.entries(files).map(([path, src]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { src },
  }));
}

const { slug } = Astro.params;
const { src } = Astro.props;
const doc = buildDoc(`concepts/${slug}`, src);
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  rawPath={doc.rawPath}
  sources={doc.sources}
  hermesVersion={doc.hermesVersion}
  confidence={doc.confidence}
>
  <article class="prose" set:html={doc.html} />
</BaseLayout>
