---
import sidebarData from '../../data/sidebar.json';
import { PAGES } from '../lib/pages.mjs';

const current = Astro.url.pathname;

const files = import.meta.glob('../raw/docs/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const titles = new Map<string, string>();
for (const [k, src] of Object.entries(files)) {
  const id = k.split('raw/docs/')[1].replace(/\.md$/, '').replace(/\/index$/, '');
  const raw = src.match(/^title:\s*(.+)$/m)?.[1]?.trim() ?? id;
  let title = raw;
  try {
    title = raw.startsWith('"') ? JSON.parse(raw) : raw;
  } catch {
    /* keep raw */
  }
  titles.set(id, title);
}

type Node = { label?: string; id?: string; items?: Node[] };

function prune(nodes: Node[]): Node[] {
  const out: Node[] = [];
  for (const n of nodes) {
    if (n.id) {
      const nid = n.id.replace(/\/index$/, '');
      if (titles.has(nid)) out.push({ id: nid });
    } else if (n.items) {
      const kept = prune(n.items);
      if (kept.length) out.push({ label: n.label, items: kept });
    }
  }
  return out;
}

function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
}

function containsCurrent(n: Node): boolean {
  if (n.id) return current === `/hermes/docs/${n.id.replace(/\/index$/, '')}/`;
  return (n.items ?? []).some(containsCurrent);
}

function renderNodes(nodes: Node[]): string {
  let out = '<ul class="space-y-0.5">';
  for (const n of nodes) {
    if (n.id) {
      const href = `/hermes/docs/${n.id}/`;
      const active = current === href;
      out += `<li><a href="${href}" class="block rounded px-2 py-1 no-underline ${
        active ? 'bg-bg-subtle font-semibold text-fg' : 'text-fg-muted hover:bg-bg-subtle hover:text-fg'
      }"${active ? ' aria-current="page"' : ''}>${esc(titles.get(n.id) ?? n.id)}</a></li>`;
    } else {
      out += `<li><details${containsCurrent(n) ? ' open' : ''}><summary class="cursor-pointer select-none rounded px-2 py-1 font-semibold text-fg">${esc(
        n.label ?? '',
      )}</summary><div class="ml-2 border-l border-border pl-2">${renderNodes(n.items ?? [])}</div></details></li>`;
    }
  }
  return out + '</ul>';
}

const tree = prune(sidebarData.tree as Node[]);
const docsHtml = tree.length ? renderNodes(tree) : '';

type Group = { name: string; items: typeof PAGES };
const groups: Group[] = [];
for (const p of PAGES) {
  if (!p.group) continue;
  const g = groups.find((x) => x.name === p.group);
  if (g) g.items.push(p);
  else groups.push({ name: p.group, items: [p] });
}
---

<aside class="hidden w-64 shrink-0 pt-8 lg:block" aria-label="サイドバー">
  <nav class="sticky top-4 max-h-[calc(100vh-2rem)] overflow-y-auto pr-2 text-sm">
    {
      groups.map((g) => (
        <details open={g.items.some((p) => p.path === current)}>
          <summary class="cursor-pointer select-none rounded px-2 py-1 font-semibold text-fg">{g.name}</summary>
          <ul class="ml-2 space-y-0.5 border-l border-border pl-2">
            {g.items.map((p) => (
              <li>
                <a
                  href={p.path}
                  class:list={[
                    'block rounded px-2 py-1 no-underline',
                    p.path === current
                      ? 'bg-bg-subtle font-semibold text-fg'
                      : 'text-fg-muted hover:bg-bg-subtle hover:text-fg',
                  ]}
                  aria-current={p.path === current ? 'page' : undefined}
                >
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
    {
      docsHtml && (
        <div class="mt-3 border-t border-border pt-3">
          <p class="px-2 pb-1 text-xs font-semibold text-fg-muted">公式ドキュメント（日本語）</p>
          <div set:html={docsHtml} />
        </div>
      )
    }
  </nav>
</aside>
