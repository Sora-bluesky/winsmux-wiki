---
// 「AI に聞く」ウィジェット。右下のフローティングボタン → 小パネル。
// 旧・下部固定バーはフッターを隠すため廃止（2026-08-27 sora 指摘）。
interface Props {
  rawPath: string;
}

const { rawPath } = Astro.props;
const rawUrl = `https://wiki.winsmux.dev${rawPath}`;
---

<div class="fixed bottom-5 right-5 z-20 flex flex-col items-end gap-2" data-ask-bar data-raw-url={rawUrl}>
  <div
    id="ask-panel"
    class="hidden w-[min(340px,calc(100vw-2.5rem))] rounded-xl border border-border bg-bg p-4 shadow-2xl"
  >
    <p class="mb-3 text-xs text-fg-muted">このページを AI に渡して、質問しながら進められます。</p>
    <div class="flex flex-col gap-2">
      <label class="sr-only" for="ask-dest">行き先</label>
      <select id="ask-dest" class="h-10 rounded-md border border-border bg-bg px-2 text-sm text-fg">
        <option value="chatgpt">ChatGPT</option>
        <option value="claude">Claude</option>
        <option value="grok">Grok</option>
        <option value="line">Hermes on LINE</option>
        <option value="telegram">Hermes on Telegram</option>
        <option value="discord">Hermes on Discord</option>
        <option value="other">Grok Bot / Gemini / 他</option>
      </select>
      <input
        id="ask-extra"
        type="text"
        placeholder="追加で伝えたいこと（任意）"
        class="h-10 min-w-0 rounded-md border border-border bg-bg px-3 text-sm text-fg"
      />
      <div class="flex gap-2">
        <button
          type="button"
          id="ask-send"
          class="inline-flex h-10 flex-1 items-center justify-center gap-1.5 rounded-md bg-accent px-3 text-sm font-medium text-white hover:bg-accent-hover"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
          聞く
        </button>
        <button
          type="button"
          id="ask-copy"
          class="inline-flex h-10 items-center gap-1.5 rounded-md border border-border px-3 text-sm text-fg hover:bg-bg-subtle"
          aria-label="コピー"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
        <button
          type="button"
          id="ask-share"
          class="inline-flex h-10 items-center gap-1.5 rounded-md border border-border px-3 text-sm text-fg hover:bg-bg-subtle"
          aria-label="共有"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"/><path d="m16 6-4-4-4 4"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/></svg>
        </button>
      </div>
    </div>
    <p id="ask-note" class="mt-2 hidden text-xs text-fg-muted"></p>
  </div>
  <button
    type="button"
    id="ask-toggle"
    aria-expanded="false"
    aria-controls="ask-panel"
    class="inline-flex h-11 items-center gap-2 rounded-full border border-border bg-bg px-4 text-sm font-medium text-fg shadow-lg hover:bg-bg-subtle"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    AI に聞く
  </button>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-ask-bar]');
    if (!bar) return;
    var rawUrl = bar.getAttribute('data-raw-url') || '';
    var panel = document.getElementById('ask-panel');
    var toggle = document.getElementById('ask-toggle');
    var dest = document.getElementById('ask-dest');
    var extra = document.getElementById('ask-extra');
    var note = document.getElementById('ask-note');
    var key = 'hermes-ja-ask-dest';
    try {
      var saved = localStorage.getItem(key);
      if (saved && dest) dest.value = saved;
    } catch (e) {}

    function setOpen(open) {
      if (!panel || !toggle) return;
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle && toggle.addEventListener('click', function () {
      setOpen(panel.classList.contains('hidden'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', function (e) {
      if (!panel || panel.classList.contains('hidden')) return;
      if (!bar.contains(e.target)) setOpen(false);
    });

    function payload() {
      var more = extra && extra.value.trim();
      var text = 'このページを読んで、私の環境でやって:\n' + rawUrl;
      if (more) text += '\n\n' + more;
      return text;
    }

    function show(msg) {
      if (!note) return;
      note.textContent = msg;
      note.classList.remove('hidden');
    }

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      return Promise.resolve();
    }

    dest && dest.addEventListener('change', function () {
      try { localStorage.setItem(key, dest.value); } catch (e) {}
    });

    document.getElementById('ask-copy')?.addEventListener('click', function () {
      copyText(payload()).then(function () { show('コピーしました。'); });
    });

    document.getElementById('ask-share')?.addEventListener('click', function () {
      var text = payload();
      if (navigator.share) {
        navigator.share({ text: text, url: rawUrl }).catch(function () {});
        return;
      }
      copyText(text).then(function () { show('共有できないのでコピーしました。'); });
    });

    document.getElementById('ask-send')?.addEventListener('click', function () {
      var text = payload();
      var where = dest ? dest.value : 'chatgpt';
      var q = encodeURIComponent(text);
      if (where === 'chatgpt') {
        window.open('https://chatgpt.com/?q=' + q, '_blank', 'noopener');
        return;
      }
      if (where === 'claude') {
        window.open('https://claude.ai/new?q=' + q, '_blank', 'noopener');
        return;
      }
      if (where === 'grok') {
        window.open('https://grok.com/?q=' + q, '_blank', 'noopener');
        return;
      }
      if (where === 'line') {
        window.open('https://line.me/R/share?text=' + q, '_blank', 'noopener');
        return;
      }
      copyText(text).then(function () {
        if (where === 'telegram') {
          show('コピーしました。自分の Hermes の Telegram ボットを開いて貼り付けてください。');
        } else if (where === 'discord') {
          show('コピーしました。Discord に貼り付けてください。');
        } else {
          show('コピーしました。使うアプリに貼り付けてください。');
        }
      });
    });
  })();
</script>
