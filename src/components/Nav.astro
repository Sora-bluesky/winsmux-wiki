---
import { PAGES } from '../lib/pages.mjs';

const path = Astro.url.pathname;
const installActive = path === '/hermes/docs/getting-started/quickstart/';
const guideActive = path.startsWith('/hermes/guide/') || path.startsWith('/hermes/ops/') || path.startsWith('/hermes/trust/');

type Group = { name: string; items: typeof PAGES };
const groups: Group[] = [];
for (const p of PAGES) {
  const g = groups.find((x) => x.name === p.group);
  if (g) g.items.push(p);
  else groups.push({ name: p.group, items: [p] });
}
---

<header class="border-b border-border bg-bg">
  <div class="mx-auto flex max-w-3xl lg:max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/hermes/" class="flex items-center gap-2 text-sm font-semibold text-fg no-underline hover:text-fg">
      Hermes Agent Wiki
      <span class="rounded-full border border-border px-2 py-px text-[10px] font-medium text-fg-muted">非公式・日本語</span>
    </a>
    <div class="flex items-center gap-2">
      <nav class="hidden items-center gap-5 text-sm sm:flex">
        <a
          href="/hermes/docs/getting-started/quickstart/"
          class:list={[
            'no-underline',
            installActive ? 'font-semibold text-fg' : 'text-fg-muted hover:text-fg',
          ]}
        >
          インストールする
        </a>
        <a
          href="/hermes/guide/"
          class:list={[
            'no-underline',
            guideActive ? 'font-semibold text-fg' : 'text-fg-muted hover:text-fg',
          ]}
        >
          Hermes Agentの使い方
        </a>
      </nav>
      <a
        href="/hermes/search/"
        class="js-search-open flex h-11 w-11 items-center justify-center rounded-lg text-fg-muted hover:bg-bg-subtle hover:text-fg"
        aria-label="検索（Ctrl+K）"
        title="検索（Ctrl+K）"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      </a>
      <button
        id="menu-button"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-lg text-fg-muted hover:bg-bg-subtle hover:text-fg lg:hidden"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg id="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
        <svg id="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </div>
  </div>
  <div id="site-menu" class="hidden border-t border-border bg-bg lg:!hidden">
    <nav class="mx-auto max-w-3xl lg:max-w-5xl px-4 py-3 sm:px-6 lg:columns-2 lg:gap-8" aria-label="全ページ">
      <a
        href="/hermes/search/"
        class="js-search-open mb-1 flex min-h-11 items-center rounded-lg px-3 text-sm text-fg-muted no-underline hover:bg-bg-subtle hover:text-fg"
      >
        検索
      </a>
      {
        groups.map((g) => (
          <div class="break-inside-avoid pb-2">
            {g.name && (
              <p class="px-3 pb-1 pt-3 text-xs font-semibold text-fg-muted">{g.name}</p>
            )}
            <ul class="space-y-1 text-sm">
              {g.items.map((p) => (
                <li>
                  <a
                    href={p.path}
                    class:list={[
                      'flex min-h-11 items-center rounded-lg px-3 no-underline',
                      p.path === path
                        ? 'bg-bg-subtle font-semibold text-fg'
                        : 'text-fg-muted hover:bg-bg-subtle hover:text-fg',
                    ]}
                    aria-current={p.path === path ? 'page' : undefined}
                  >
                    {p.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('site-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setOpen(open: boolean) {
    if (!button || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  }

  button?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
