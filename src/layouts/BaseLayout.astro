---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import SearchModal from '../components/SearchModal.astro';
import Sidebar from '../components/Sidebar.astro';
import { PAGES } from '../lib/pages.mjs';
import updatesData from '../../data/wiki-updates.json';

type PageLink = { path: string; label: string } | null;

interface Props {
  title: string;
  description: string;
  rawPath?: string;
  sources?: string[];
  hermesVersion?: string;
  confidence?: string;
  tocRail?: string;
  prevOverride?: PageLink;
  nextOverride?: PageLink;
}

const {
  title,
  description,
  rawPath,
  sources = [],
  hermesVersion,
  confidence,
  tocRail = '',
} = Astro.props;

// 共通右サイドバー（xl+）: 目次 / よく使うページ / 今週の更新ミニ
const POPULAR: [string, string][] = [
  ['/hermes/docs/getting-started/quickstart/', 'インストールする'],
  ['/hermes/docs/user-guide/messaging/telegram/', 'Telegram でつなぐ'],
  ['/hermes/docs/user-guide/features/cron/', '定時実行（Cron）'],
  ['/hermes/models/', 'モデルと料金'],
  ['/hermes/trouble/', 'トラブル'],
];
type UpdateEntry = { date: string; pages: { title: string }[] };
const recentUpdates = (updatesData.entries as UpdateEntry[]).slice(0, 3);
const updateLine = (e: UpdateEntry) =>
  e.pages.length === 1 ? `「${e.pages[0].title}」を更新` : `${e.pages.length}ページを更新`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const feedbackUrl = `https://github.com/Sora-bluesky/winsmux-wiki/issues/new?template=feedback.yml&page=${encodeURIComponent(canonical)}`;

// パンくず: /hermes/ 直下以外で表示。中間セグメントはラベル化（ページが無いのでテキスト）。
const CRUMB_LABELS: Record<string, string> = {
  docs: 'ドキュメント',
  'getting-started': '導入',
  'user-guide': 'Hermes を使う',
  features: '機能',
  messaging: 'メッセージング',
  integrations: '連携',
  guides: 'ガイド',
  'developer-guide': '開発者向け',
  reference: '早見表',
  skills: 'skill',
  bundled: '最初から入っている',
  optional: 'あとから入れる',
  guide: '使い方',
  concepts: 'しくみ',
  entities: '使う形',
  syntheses: 'まとめ',
};
// ミラーページの実在集合（キーだけ使うので eager 読み込みはしない）
const docFiles = import.meta.glob('../raw/docs/**/*.md');
const docIds = new Set(
  Object.keys(docFiles).map((k) => k.split('raw/docs/')[1].replace(/\.md$/, '').replace(/\/index$/, '')),
);
const crumbSegs = Astro.url.pathname.replace(/^\/hermes\/?/, '').replace(/\/$/, '').split('/').filter(Boolean);
// 中間階層は、実在するページにだけリンクを張る（無い階層はテキスト）
const crumbHref = (i: number): string | null => {
  const seg = crumbSegs[i];
  if (i === 0) {
    if (seg === 'docs') return '/hermes/guide/all/';
    if (seg === 'guide') return '/hermes/guide/';
    return null;
  }
  if (crumbSegs[0] !== 'docs') return null;
  const prefix = crumbSegs.slice(1, i + 1).join('/');
  if (prefix === 'user-guide/skills') return '/hermes/guide/skills/';
  if (docIds.has(prefix)) return `/hermes/docs/${prefix}/`;
  return null;
};
const crumbs = crumbSegs.slice(0, -1).map((s, i) => ({ label: CRUMB_LABELS[s] ?? s, href: crumbHref(i) }));
const showCrumbs = crumbSegs.length > 0;
// JSON-LD（標準スキーマのみ。WebSite + パンくず、about は運営者の Person）
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Hermes Agent Wiki',
    url: 'https://wiki.winsmux.dev/hermes/',
    inLanguage: 'ja',
  },
];
if (crumbSegs.length > 0) {
  const items = [{ name: 'ホーム', item: 'https://wiki.winsmux.dev/hermes/' } as { name: string; item?: string }]
    .concat(crumbs.map((c) => ({ name: c.label, ...(c.href ? { item: `https://wiki.winsmux.dev${c.href}` } : {}) })))
    .concat([{ name: title }]);
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, ...it })),
  });
}
if (Astro.url.pathname === '/hermes/about/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'そら',
    url: 'https://wiki.winsmux.dev/hermes/about/',
    jobTitle: 'プロダクトマネージャー',
    sameAs: ['https://x.com/sora_biz', 'https://github.com/Sora-bluesky'],
  });
}
const pageIndex = PAGES.findIndex((p) => p.path === Astro.url.pathname);
const hasOverride = 'prevOverride' in Astro.props || 'nextOverride' in Astro.props;
const prev = hasOverride ? (Astro.props.prevOverride ?? null) : pageIndex > 0 ? PAGES[pageIndex - 1] : null;
const next = hasOverride
  ? (Astro.props.nextOverride ?? null)
  : pageIndex >= 0 && pageIndex < PAGES.length - 1
    ? PAGES[pageIndex + 1]
    : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Hermes Agent Wiki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).toString()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <Nav />
    <div class="mx-auto flex w-full max-w-3xl gap-8 px-4 sm:px-6 lg:max-w-7xl xl:max-w-[88rem] 2xl:max-w-[96rem]">
      <Sidebar />
      <main class="w-full min-w-0 flex-1 pb-16 pt-8 lg:max-w-5xl xl:max-w-4xl 2xl:max-w-5xl">
      {
        showCrumbs && (
          <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-fg-muted" aria-label="現在地">
            <a href="/hermes/" class="text-fg-muted no-underline hover:text-fg hover:underline">
              ホーム
            </a>
            {crumbs.map((c) => (
              <>
                <span aria-hidden="true">›</span>
                {c.href ? (
                  <a href={c.href} class="text-fg-muted no-underline hover:text-fg hover:underline">
                    {c.label}
                  </a>
                ) : (
                  <span>{c.label}</span>
                )}
              </>
            ))}
            <span aria-hidden="true">›</span>
            <span class="text-fg-secondary">{title}</span>
          </nav>
        )
      }
      {
        rawPath && (
          <div class="relative mb-3 flex justify-end" data-copy-page data-raw-path={rawPath}>
            <button
              type="button"
              id="copy-page-toggle"
              aria-expanded="false"
              aria-controls="copy-page-menu"
              class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-border bg-bg px-3 text-xs font-medium text-fg-secondary hover:bg-bg-subtle"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
              <span id="copy-page-label">ページをコピー</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div
              id="copy-page-menu"
              class="absolute right-0 top-10 z-10 hidden w-72 rounded-xl border border-border bg-bg p-1.5 shadow-2xl"
            >
              <button type="button" id="copy-page-md" class="flex w-full flex-col items-start gap-0.5 rounded-lg px-3 py-2 text-left hover:bg-bg-subtle">
                <span class="text-sm font-medium text-fg">ページをコピー</span>
                <span class="text-xs text-fg-muted">AI に渡せる Markdown でページをコピー</span>
              </button>
              <a href={rawPath} target="_blank" rel="noopener" class="flex w-full flex-col items-start gap-0.5 rounded-lg px-3 py-2 text-left no-underline hover:bg-bg-subtle">
                <span class="text-sm font-medium text-fg">マークダウンで表示</span>
                <span class="text-xs text-fg-muted">このページをプレーンテキストで表示</span>
              </a>
              <div class="mx-3 my-1 border-t border-border" role="separator"></div>
              <button type="button" data-open-ai="chatgpt" class="flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium text-fg hover:bg-bg-subtle">ChatGPT で開く</button>
              <button type="button" data-open-ai="claude" class="flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium text-fg hover:bg-bg-subtle">Claude で開く</button>
              <button type="button" data-open-ai="gemini" class="flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium text-fg hover:bg-bg-subtle">Gemini で開く</button>
              <button type="button" data-open-ai="grok" class="flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium text-fg hover:bg-bg-subtle">Grok で開く</button>
              <p class="px-3 pb-1 pt-1.5 text-xs text-fg-muted">質問文入りで開きます（Gemini はコピーしてから開くので貼り付けてください）。</p>
            </div>
          </div>
        )
      }
      <slot />
      {
        (prev || next) && (
          <nav class="mt-12 flex items-stretch justify-between gap-3 border-t border-border pt-6 text-sm" aria-label="前後のページ">
            {prev ? (
              <a
                href={prev.path}
                class="flex min-h-11 max-w-[48%] items-center gap-2 rounded-lg border border-border px-4 py-2 text-fg no-underline hover:bg-bg-subtle"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                <span>
                  <span class="block text-xs text-fg-muted">前へ</span>
                  {prev.label}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                href={next.path}
                class="flex min-h-11 max-w-[48%] items-center gap-2 rounded-lg border border-border px-4 py-2 text-right text-fg no-underline hover:bg-bg-subtle"
              >
                <span>
                  <span class="block text-xs text-fg-muted">次へ</span>
                  {next.label}
                </span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            )}
          </nav>
        )
      }
      {
        sources.length > 0 && (
          <aside class="mt-12 border-t border-border pt-6 text-sm text-fg-muted">
            <p>
              このページの正本:{' '}
              {sources.map((url, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={url} target="_blank" rel="noopener">
                    {url.replace('https://hermes-agent.nousresearch.com', '')}
                  </a>
                </>
              ))}
            </p>
          </aside>
        )
      }
      </main>
      <aside class="hidden w-60 shrink-0 pt-8 xl:block" aria-label="サイドの案内">
        <div class="sticky top-[4.75rem] max-h-[calc(100vh-6rem)] overflow-y-auto pr-1 text-sm">
          {
            tocRail && (
              <nav class="toc-rail" aria-label="このページの目次">
                <p class="pb-1 text-xs font-semibold text-fg-muted">目次</p>
                <div set:html={tocRail} />
              </nav>
            )
          }
          <div class:list={['border-border', tocRail ? 'mt-6 border-t pt-4' : '']}>
            <p class="pb-1 text-xs font-semibold text-fg-muted">よく使うページ</p>
            <ul class="space-y-1">
              {POPULAR.map(([href, label]) => (
                <li>
                  <a class="text-fg-muted no-underline hover:text-fg" href={href}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-6 border-t border-border pt-4">
            <p class="pb-1 text-xs font-semibold text-fg-muted">今週の更新</p>
            <ul class="space-y-2">
              {recentUpdates.map((e) => (
                <li>
                  <a class="text-fg-muted no-underline hover:text-fg" href="/hermes/updates/">
                    <span class="block font-mono text-[10px]">{e.date}</span>
                    {updateLine(e)}
                  </a>
                </li>
              ))}
            </ul>
            <a class="mt-2 inline-block text-xs no-underline hover:underline" href="/hermes/updates/">一覧を見る →</a>
          </div>
        </div>
      </aside>
    </div>
    <footer class="border-t border-border bg-bg-subtle">
      <div class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 py-6 text-xs text-fg-muted sm:px-6 md:flex-row md:items-center md:justify-between lg:max-w-7xl">
        <p class="m-0">
          Hermes Agent Wiki — 非公式の日本語サイトです{hermesVersion && `（Hermes Agent ${hermesVersion} 時点）`}。<br />正本:
          <a href="https://hermes-agent.nousresearch.com/docs/" target="_blank" rel="noopener">公式ドキュメント</a>
          · <a href="/hermes/about/">このサイトについて</a>
          · <a href={feedbackUrl} target="_blank" rel="noopener" title="このページの URL 入りで GitHub の入力フォームが開きます">意見・要望</a>
        </p>
        <p class="m-0 flex shrink-0 items-center gap-4 whitespace-nowrap">
          <span>管理人: そら</span>
          <a href="https://x.com/sora_biz" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 text-fg-muted no-underline hover:text-fg" aria-label="X（@sora_biz）">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z" /></svg>
            @sora_biz
          </a>
          <a href="https://github.com/Sora-bluesky" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 text-fg-muted no-underline hover:text-fg" aria-label="GitHub（Sora-bluesky）">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" /></svg>
            GitHub
          </a>
        </p>
      </div>
    </footer>
    <button
      type="button"
      id="back-to-top"
      aria-label="ページの先頭へ戻る"
      class="pointer-events-none fixed bottom-[4.75rem] right-5 z-20 flex h-11 w-11 items-center justify-center rounded-full border border-border bg-bg text-fg-muted opacity-0 shadow-lg transition-opacity duration-200 hover:bg-bg-subtle hover:text-fg"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
    </button>
    <script is:inline>
      (function () {
        var wrap = document.querySelector('[data-copy-page]');
        if (!wrap) return;
        var rawPath = wrap.getAttribute('data-raw-path') || '';
        var rawUrl = 'https://wiki.winsmux.dev' + rawPath;
        var toggle = document.getElementById('copy-page-toggle');
        var menu = document.getElementById('copy-page-menu');
        var label = document.getElementById('copy-page-label');
        function setOpen(open) {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        toggle.addEventListener('click', function () {
          setOpen(menu.classList.contains('hidden'));
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        document.addEventListener('click', function (e) {
          if (!menu.classList.contains('hidden') && !wrap.contains(e.target)) setOpen(false);
        });
        document.getElementById('copy-page-md').addEventListener('click', function () {
          fetch(rawPath)
            .then(function (r) { return r.text(); })
            .then(function (text) { return navigator.clipboard.writeText(text); })
            .then(function () {
              label.textContent = 'コピーしました';
              setOpen(false);
              setTimeout(function () { label.textContent = 'ページをコピー'; }, 2000);
            })
            .catch(function () {
              label.textContent = 'コピーできませんでした';
              setTimeout(function () { label.textContent = 'ページをコピー'; }, 2000);
            });
        });
        // 公式 Claude Code docs と同じく、プロンプトは URL で渡す（claude.ai の注意帯は
        // ?q= 全般に出る標準表示）。Gemini だけ URL で渡せないためコピーしてから開く
        var openUrls = {
          chatgpt: 'https://chatgpt.com/?q=',
          claude: 'https://claude.ai/new?q=',
          grok: 'https://grok.com/?q=',
        };
        wrap.querySelectorAll('[data-open-ai]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var ai = btn.getAttribute('data-open-ai');
            var text = 'このページを読んで、内容について質問に答えて:\n' + rawUrl;
            if (ai === 'gemini') {
              // Gemini はプロンプトを URL で受け取れない。フォーカスが移る前に
              // コピーを完了させてから開く（先に open すると writeText が拒否される）
              navigator.clipboard.writeText(text).then(
                function () { label.textContent = 'コピーしました。Gemini に貼り付けてください'; },
                function () { label.textContent = 'コピーできませんでした'; },
              ).then(function () {
                window.open('https://gemini.google.com/app', '_blank', 'noopener');
                setTimeout(function () { label.textContent = 'ページをコピー'; }, 4000);
              });
            } else {
              window.open(openUrls[ai] + encodeURIComponent(text), '_blank', 'noopener');
            }
            setOpen(false);
          });
        });
      })();
    </script>
    <SearchModal />
    <script>
      // 右レール目次の現在地追従（scroll 位置から決定論的に計算）
      const rail = document.querySelector('.toc-rail');
      if (rail) {
        const links = new Map(
          [...rail.querySelectorAll('a[href^="#"]')].map((a) => [
            decodeURIComponent(a.getAttribute('href')!.slice(1)),
            a,
          ]),
        );
        const targets = [...links.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        let ticking = false;
        const update = () => {
          ticking = false;
          const line = window.scrollY + window.innerHeight * 0.3;
          let current: string | null = null;
          for (const el of targets) {
            if (el.offsetTop <= line) current = el.id;
            else break;
          }
          for (const a of links.values()) a.classList.remove('font-semibold', 'text-fg');
          if (current) links.get(current)?.classList.add('font-semibold', 'text-fg');
        };
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        update();
      }
      // 上に戻るボタン（スクロールで出現）
      const topBtn = document.getElementById('back-to-top');
      if (topBtn) {
        let topTicking = false;
        const updateTop = () => {
          topTicking = false;
          const on = window.scrollY > 400;
          topBtn.classList.toggle('opacity-0', !on);
          topBtn.classList.toggle('pointer-events-none', !on);
        };
        addEventListener(
          'scroll',
          () => {
            if (!topTicking) {
              topTicking = true;
              requestAnimationFrame(updateTop);
            }
          },
          { passive: true },
        );
        topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        updateTop();
      }
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('.copy-code');
        if (!(btn instanceof HTMLButtonElement)) return;
        const code = btn.parentElement?.querySelector('pre code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'コピーしました';
        } catch {
          btn.textContent = 'コピーできません';
        }
        setTimeout(() => {
          btn.textContent = 'コピー';
        }, 1500);
      });
    </script>
  </body>
</html>
