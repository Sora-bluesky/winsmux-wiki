---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import AskBar from '../components/AskBar.astro';
import { PAGES } from '../lib/pages.mjs';

interface Props {
  title: string;
  description: string;
  rawPath?: string;
  sources?: string[];
  hermesVersion?: string;
  confidence?: string;
  showAsk?: boolean;
}

const {
  title,
  description,
  rawPath,
  sources = [],
  hermesVersion,
  confidence,
  showAsk = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const pageIndex = PAGES.findIndex((p) => p.path === Astro.url.pathname);
const prev = pageIndex > 0 ? PAGES[pageIndex - 1] : null;
const next = pageIndex >= 0 && pageIndex < PAGES.length - 1 ? PAGES[pageIndex + 1] : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="wiki.winsmux.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <Nav />
    <main class="mx-auto w-full max-w-3xl lg:max-w-5xl px-4 pb-36 pt-8 sm:px-6">
      <slot />
      {
        (prev || next) && (
          <nav class="mt-12 flex items-stretch justify-between gap-3 border-t border-border pt-6 text-sm" aria-label="前後のページ">
            {prev ? (
              <a
                href={prev.path}
                class="flex min-h-11 max-w-[48%] items-center gap-2 rounded-lg border border-border px-4 py-2 text-fg no-underline hover:bg-bg-subtle"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                <span>
                  <span class="block text-xs text-fg-muted">前へ</span>
                  {prev.label}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                href={next.path}
                class="flex min-h-11 max-w-[48%] items-center gap-2 rounded-lg border border-border px-4 py-2 text-right text-fg no-underline hover:bg-bg-subtle"
              >
                <span>
                  <span class="block text-xs text-fg-muted">次へ</span>
                  {next.label}
                </span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            )}
          </nav>
        )
      }
      {
        (sources.length > 0 || hermesVersion) && (
          <aside class="mt-12 border-t border-border pt-6 text-sm text-fg-muted">
            {hermesVersion && <p>Hermes Agent {hermesVersion}</p>}
            {sources.length > 0 && (
              <p class="mt-2">
                正本:{' '}
                {sources.map((url, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={url} target="_blank" rel="noopener">
                      {url.replace('https://hermes-agent.nousresearch.com', '')}
                    </a>
                  </>
                ))}
              </p>
            )}
          </aside>
        )
      }
    </main>
    {showAsk && rawPath && <AskBar rawPath={rawPath} />}
  </body>
</html>
